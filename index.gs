const express = require('express'); const app = express(); const verify_token = 'verification_token'; app.get('/webhook', (req, res) => { const mode = req.query['hub.mode']; const token = req.query['hub.verify_token']; const challenge = req.query['hub.challenge']; if (mode && token) { if (mode === 'subscribe' && token === verify_token) { res.status(200).send(challenge); } else { res.sendStatus(403); } } }); app.listen(process.env.PORT || 1337, () => console.log('webhook is listening'));
